    {
      "name": "S. Pruebas de seguridad (401 / 403)",
      "item": [
        {
          "name": "Sin token -> 401 Unauthorized",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productores",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sin token', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Token invalido -> 401 Unauthorized",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer abc.def.ghi"
              }
            ],
            "url": "{{baseUrl}}/api/productores",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
